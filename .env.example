# Kopieren nach .env (wird von git ignoriert) und ausfüllen.

# OAuth-Access-Token mit dem Scope w_member_social
LINKEDIN_ACCESS_TOKEN=

# Optional: eigene Person-URN, z. B. urn:li:person:AbC123
# Leer lassen, dann wird sie automatisch über /v2/userinfo ermittelt.
LINKEDIN_AUTHOR_URN=

# Optional: API-Version im Format JJJJMM, falls die Voreinstellung abgelaufen ist
LINKEDIN_API_VERSION=

# Optional: Zeitzone für Zeitangaben ohne Offset (Standard: Europe/Berlin)
SCHEDULER_TZ=Europe/Berlin
